# Copie para .env.local. Nada aqui é obrigatório em desenvolvimento:
# sem Redis o app usa um store em memória e o PIN do admin vira "1234".

# PIN do painel /admin. Em produção, sem ele o admin fica desativado.
ADMIN_PIN=

# Redis (Upstash). Use UM dos pares abaixo.
# A integração "Upstash for Redis" da Vercel injeta KV_REST_API_URL/KV_REST_API_TOKEN automaticamente.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Banco criado direto no console da Upstash:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Prefixo das chaves no Redis (padrão: mural). Útil para separar oficinas no mesmo banco.
MURAL_PREFIX=mural

# URL pública usada no QR code do telão (padrão: a origem em que o telão foi aberto).
# É embutida no build: mudou, faça redeploy.
NEXT_PUBLIC_APP_URL=
